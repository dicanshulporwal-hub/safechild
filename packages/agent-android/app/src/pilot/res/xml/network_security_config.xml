<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      SafeBrowse Pilot Build Configuration:
      Strict HTTPS enforcement matching production. Cleartext HTTP is prohibited.
      Trust anchors use standard Android system CA certificates.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
