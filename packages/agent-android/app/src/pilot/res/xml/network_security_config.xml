<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      SafeBrowse Pilot Build Configuration:
      Permits cleartext HTTP traffic specifically for private development and mesh network testing (100.88.17.16:11002).
      Specific destination endpoint restrictions are enforced programmatically by AgentConfig.validateApiBaseUrl().
      Production release builds strictly enforce cleartextTrafficPermitted="false" with HTTPS only.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
