# SafeBrowse Production Environment Configuration Template (VM2 Limited Parent Beta)
NODE_ENV=production
PORT=3000
STORAGE_MODE=postgres

# Production Domain Architecture
APP_URL=https://safebrowse.porwal.online
CORS_ALLOWED_ORIGINS=https://safebrowse.porwal.online
TRUST_PROXY=loopback, uniquelocal

# Feature & Admin Flags
ENABLE_DEV_ADMIN_BOOTSTRAP=false
ENABLE_DEMO_DATA=false
AUTO_SEED_DEMO=false

# Cryptographic & Security Secrets (MANDATORY: MUST BE CONFIGURED BEFORE STARTUP)
# Production requires minimum 32 characters for JWT_SECRET and MFA_ENCRYPTION_KEY
JWT_SECRET=<generate-a-random-secret-of-at-least-32-chars>
MFA_ENCRYPTION_KEY=<generate-a-random-32-byte-hex-or-string-min-32-chars>
JWT_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12

# Database Connection (Mandatory PostgreSQL single system of record)
DATABASE_URL=postgresql://<user>:<password>@<private-host>:5432/<database>?schema=public

# Production Transactional Mail (Resend API required in production)
RESEND_API_KEY=re_<generate-or-configure-resend-api-key>
MAIL_FROM=SafeBrowse Security <noreply@safebrowse.porwal.online>

# Rate Limiting & Abuse Prevention
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
PAIRING_RATE_LIMIT_MAX=10
PAIRING_RATE_LIMIT_WINDOW_MS=60000

# Automated Disaster Recovery & Backup Cadence
BACKUP_ENABLED=true
BACKUP_INTERVAL_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=30
