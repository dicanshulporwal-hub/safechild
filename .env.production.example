# SafeBrowse Production Environment Configuration Template
NODE_ENV=production
PORT=1002

# Production Domain Architecture
APP_URL=https://parent.safebrowse.io
API_URL=https://api.safebrowse.io
WS_URL=wss://ws.safebrowse.io
DOWNLOADS_URL=https://downloads.safebrowse.io
STATUS_URL=https://status.safebrowse.io

# Cryptographic & Security Secrets (MANDATORY: MUST BE ROTATED BEFORE DEPLOYMENT)
JWT_SECRET=<generate-a-random-secret-of-at-least-64-bytes>
MFA_ENCRYPTION_KEY=<generate-a-random-32-byte-key>
JWT_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12

# Database & Cache Connection
DATABASE_URL=postgresql://<user>:<password>@<private-host>:5432/<database>
REDIS_URL=rediss://:<password>@<private-host>:6379/0

# Production Transactional Mail (SMTP)
MAIL_PROVIDER=smtp
MAIL_FROM=SafeBrowse Security <noreply@safebrowse.io>
SMTP_HOST=<smtp-provider-host>
SMTP_PORT=587
SMTP_USER=<smtp-auth-username>
SMTP_PASS=<smtp-auth-password>
SMTP_SECURE=false

# Rate Limiting & Abuse Prevention
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
PAIRING_RATE_LIMIT_MAX=5
PAIRING_RATE_LIMIT_WINDOW_MS=300000

# Automated Disaster Recovery & Backup Cadence
BACKUP_ENABLED=true
BACKUP_INTERVAL_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=30
