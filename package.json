{
  "name": "safebrowse-platform",
  "version": "1.0.0",
  "private": true,
  "description": "SafeBrowse - Cross-Device Child Web Protection Platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.js",
    "build:shared": "npm run build --workspace=@safebrowse/shared",
    "build:protocol": "npm run build --workspace=@safebrowse/protocol",
    "build:windows": "npm run build --workspace=@safebrowse/agent-windows",
    "build:backend": "npm run build --workspace=@safebrowse/backend",
    "build:web": "npm run build --workspace=@safebrowse/parent-web",
    "build": "npm run build:shared && npm run build:protocol && npm run build:windows && npm run build:backend && npm run build:web",
    "dev:backend": "npm run dev --workspace=@safebrowse/backend",
    "dev:web": "npm run dev --workspace=@safebrowse/parent-web",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:web\"",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "ts-node scripts/test-e2e-scenario.ts",
    "test:postgres:e2e": "node --test packages/backend/dist/tests/postgres-e2e.test.js",
    "verify:postgres-cutover": "ts-node scripts/verify-postgres-cutover.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:test:reset": "prisma migrate reset --force",
    "db:import:dry": "ts-node scripts/import-json-to-postgres.ts",
    "db:import:apply": "ts-node scripts/import-json-to-postgres.ts --apply",
    "db:add-user": "ts-node scripts/add-user.ts",
    "package:step3f": "ts-node scripts/package-step3f.ts",
    "verify:release-archive": "ts-node scripts/verify-release-archive.ts",
    "build:pilot": "ts-node scripts/build-pilot-artifacts.ts",
    "package:step4": "ts-node scripts/build-pilot-artifacts.ts && ts-node scripts/package-step4.ts",
    "verify:step4-archive": "ts-node scripts/verify-step4-archive.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
