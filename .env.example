# SafeBrowse Environment Configuration Template
PORT=3000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-safebrowse-platform-production-needs-32chars
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public
TEST_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<test_database>?schema=public
ENABLE_DEV_ADMIN_BOOTSTRAP=false
ENABLE_DEMO_DATA=false
SMTP_MODE=development
