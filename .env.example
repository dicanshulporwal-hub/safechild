# SafeBrowse Environment Configuration Template
# Copy this file to .env and configure before starting the services

# Application Environment ('development', 'staging', 'production', 'test')
NODE_ENV=development

# Server Port Configuration
PORT=1002

# Authentication & Cryptographic Keys
# In production (NODE_ENV=production), startup will fail if these are missing or shorter than 32 characters
JWT_SECRET=your-256-bit-jwt-secret-placeholder-min-32-chars
MFA_ENCRYPTION_KEY=your-aes-256-mfa-encryption-key-placeholder-32-bytes!

# Feature Flags
# Set to 'true' only in development if you wish to seed initial demo accounts
ENABLE_DEMO_DATA=false

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:1001,http://localhost:3000

# Optional Redis / Caching Layer
# REDIS_URL=redis://:your-redis-password-placeholder@127.0.0.1:6379/0

# Optional Database Connection String
# DATABASE_URL=postgresql://safebrowse_user:your-db-password-placeholder@localhost:5432/safebrowse_db
